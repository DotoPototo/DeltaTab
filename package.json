{
  "name": "delta-tab",
  "description": "A beautiful new tab: daily wallpapers, the time, and a dashboard of the widgets you choose.",
  "version": "1.0.0-beta",
  "author": "DotoPototo",
  "homepage": "https://github.com/DotoPototo/DeltaTab",
  "repository": "github:DotoPototo/DeltaTab",
  "bugs": "https://github.com/DotoPototo/DeltaTab/issues",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt zip",
    "build:firefox": "wxt zip -b firefox",
    "preview": "vite --config preview/vite.config.ts",
    "lint": "oxlint . --fix && eslint . --fix --cache",
    "lint:ci": "oxlint . && eslint .",
    "type-check": "vue-tsc --build",
    "test": "bun test",
    "format": "prettier --write --experimental-cli src/ tests/ preview/ scripts/",
    "format:check": "prettier --check --experimental-cli src/ tests/ preview/ scripts/",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-tippy": "6.8.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/material-symbols": "^1.2.98",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "bun-types": "^1.4.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.93.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14",
    "wxt": "^0.21.5"
  }
}
